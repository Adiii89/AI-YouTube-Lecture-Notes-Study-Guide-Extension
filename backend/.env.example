# Backend Configuration
PROJECT_NAME="AI YouTube Lecture Notes API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="127.0.0.1"
PORT=8000

# LLM Provider Selection: "auto", "openai", or "gemini"
LLM_PROVIDER="openai"

# OpenAI AI Settings
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini AI Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS (Comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","chrome-extension://*"]
