# LLM Provider Selection: "auto", "openai", or "gemini"
LLM_PROVIDER=auto

# OpenAI Configuration (Required if LLM_PROVIDER is "openai" or "auto" with OpenAI key)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Required if LLM_PROVIDER is "gemini" or "auto" with Gemini key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
